# Token obtenido desde @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_token_aqui_123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# (Opcional) ID de Monedero por defecto para no requerir /vincular
DEFAULT_WALLET_ID=

# (Opcional pero recomendado) Google Gemini API Key para lectura automática de facturas y fotos
# Consíguela 100% gratis en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modo: 'polling' (para correr local sin HTTPS) o 'webhook' (para servidores de producción)
BOT_MODE=polling

# Puerto HTTP (solo para modo webhook)
PORT=3000
